# Kopie als .env auf core01 (chmod 600). Nicht einchecken.
PINECONE_PUBLIC_URL=https://pinecone.twogg.app
PINECONE_ADMIN_USER=admin
# Klartext (mind. 10 Zeichen, wird beim Start gehasht) …
PINECONE_ADMIN_PASSWORD=
# … oder besser ein Argon2-Hash: docker compose run --rm pinecone hash-password '<passwort>'
# PINECONE_ADMIN_PASSWORD_HASH=
# Gültigkeit der Download-Links in Sekunden
PINECONE_DOWNLOAD_TTL=600
# Wo der Container auf core01 lauscht (interne/VPN-IP, NPM-Ziel); setzt deploy.ps1 beim ersten Deploy
BIND_IP=
PORT=8095
